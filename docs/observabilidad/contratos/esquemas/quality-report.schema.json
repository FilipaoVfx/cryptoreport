{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Informe de calidad de datos",
  "description": "Resultado de aplicar los umbrales DQ-* a una versión de un activo. Cada comprobación cita el ID del umbral del registro, de modo que el informe se puede auditar contra umbrales.json.",
  "type": "object",
  "required": ["report_id", "subject", "stage", "evaluated_at", "gate", "verdict", "checks"],
  "additionalProperties": false,
  "properties": {
    "report_id": {"$ref": "common.schema.json#/$defs/Uuid"},
    "subject": {
      "type": "object",
      "required": ["asset_id", "version"],
      "additionalProperties": false,
      "properties": {
        "asset_id": {"$ref": "common.schema.json#/$defs/AssetId"},
        "version": {"$ref": "common.schema.json#/$defs/Sha256"}
      }
    },
    "stage": {"enum": ["video_metadata", "transcript", "chunking", "embeddings", "tagging", "analysis"]},
    "evaluated_at": {"$ref": "common.schema.json#/$defs/Timestamp"},
    "gate": {
      "type": "object",
      "required": ["id", "code_version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "Puerta aplicada, p. ej. crtranscripts.quality.assess."},
        "code_version": {"type": "string", "minLength": 1}
      }
    },
    "verdict": {"enum": ["valid", "warning", "invalid"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["threshold_id", "status"],
        "additionalProperties": false,
        "properties": {
          "threshold_id": {"type": "string", "pattern": "^DQ-(V|T|C|E|M|A)-[0-9]{2}$"},
          "status": {"enum": ["pass", "warn", "fail", "skip"]},
          "observed": {"type": ["number", "string", "boolean", "null"]},
          "reason_code": {"type": "string", "description": "Código heredado de assess (p. ej. posible_corte_final)."},
          "message": {"type": "string", "maxLength": 300}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_s": {"type": ["number", "null"], "minimum": 0},
        "segment_count": {"type": "integer", "minimum": 0},
        "coverage": {"type": ["number", "null"], "minimum": 0},
        "words_per_minute": {"type": ["number", "null"], "minimum": 0},
        "nonverbal_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_gap_s": {"type": ["number", "null"]}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "valid"}}}, "then": {"properties": {"checks": {"items": {"properties": {"status": {"enum": ["pass", "skip"]}}}}}}},
    {"if": {"properties": {"verdict": {"const": "invalid"}}}, "then": {"properties": {"checks": {"contains": {"properties": {"status": {"const": "fail"}}}}}}},
    {"if": {"properties": {"verdict": {"const": "warning"}}}, "then": {"properties": {"checks": {"contains": {"properties": {"status": {"const": "warn"}}}, "items": {"properties": {"status": {"enum": ["pass", "warn", "skip"]}}}}}}}
  ]
}
