{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Definiciones comunes",
  "description": "Tipos compartidos por todos los contratos de observabilidad y del panel de Urania/Diario. Los identificadores siguen el formato real del sistema (video_id de YouTube, job_id del puente) y las marcas de tiempo son RFC 3339 con zona.",
  "$defs": {
    "Timestamp": {
      "description": "Instante RFC 3339 con zona horaria explícita (Z u offset).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "Sha256": {
      "description": "SHA-256 en hexadecimal minúscula (64 caracteres).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Uuid": {
      "description": "UUID canónico en minúsculas, versiones 1 a 8.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "RunId": {
      "description": "Identidad de una ejecución: UUIDv7 si la genera un servicio propio; UUIDv5 determinista si se reconstruye a partir de un comprobante externo.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "TraceId": {
      "description": "trace_id W3C/OTel: 32 hexadecimales, nunca todo ceros.",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {"const": "00000000000000000000000000000000"}
    },
    "SpanId": {
      "description": "span_id W3C/OTel: 16 hexadecimales, nunca todo ceros.",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "not": {"const": "0000000000000000"}
    },
    "VideoId": {
      "description": "Identificador de video de YouTube (11 caracteres).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "ChannelSlug": {
      "description": "Slug del canal tal como aparece en services/transcripts/channels.json.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "JobId": {
      "description": "Identidad determinista de un trabajo del puente: <video_id>__<sha256 de los metadatos del trabajo> (crbridge/core.py, make_job).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}__[0-9a-f]{64}$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "ServiceName": {
      "description": "Valor de service.name. cr-scheduled-agent solo aparece en telemetría reconstruida por el puente.",
      "enum": ["cr-extractor", "cr-bridge", "cr-analysis", "cr-build-data", "cr-panel", "cr-scheduled-agent"]
    },
    "Role": {
      "description": "Roles del panel: viewer (lector), reviewer (revisor), operator (operador), admin (administrador), auditor.",
      "enum": ["viewer", "reviewer", "operator", "admin", "auditor"]
    },
    "Severity": {
      "enum": ["info", "warning", "critical"]
    },
    "Actor": {
      "description": "Quién hace algo. Las personas se identifican por su cuenta del panel, nunca por correo.",
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["user", "service", "agent", "system"]},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "display_name": {"type": "string", "maxLength": 80},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/Role"}, "uniqueItems": true}
      }
    },
    "TargetKind": {
      "enum": ["video", "transcript", "analysis", "claim", "evidence", "segment", "tone_label", "topic_mention", "chunk", "vector_index", "prompt", "schema", "instructions", "receipt", "job", "run", "parameter", "config_version", "config_change", "tool", "guardrail", "routing_rule", "intervention", "feedback", "alert", "audit_event", "session"]
    },
    "TargetRef": {
      "description": "Referencia a cualquier objeto observable. version fija el contenido exacto (SHA-256) cuando el objeto es versionable.",
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "#/$defs/TargetKind"},
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"$ref": "#/$defs/Sha256"},
        "path": {"description": "Puntero JSON dentro del objeto (p. ej. /afirmaciones/3).", "type": "string", "pattern": "^(/[^/]*)*$"}
      }
    },
    "AssetId": {
      "description": "Identidad estable de un activo de la Biblioteca: <tipo>:<clave natural>.",
      "type": "string",
      "pattern": "^(video|audio|transcript|analysis|chunk_set|prompt|schema|instructions|receipt|vector_index):[A-Za-z0-9_.-]{1,128}$"
    },
    "Money": {
      "type": "object",
      "required": ["amount_usd", "estimated"],
      "additionalProperties": false,
      "properties": {
        "amount_usd": {"type": "number", "minimum": 0},
        "estimated": {"type": "boolean", "description": "true si sale de la tabla PRICES y no de una factura."},
        "price_table": {"type": "string", "description": "Origen de los precios, p. ej. services/analysis/cranalysis/client.py#PRICES@<commit>."}
      }
    },
    "TokenUsage": {
      "description": "Uso de tokens normalizado a OTel GenAI: input_tokens incluye lecturas y escrituras de caché (regla de anthropic.md en la instantánea fijada); output_tokens incluye el razonamiento.",
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cache_read_input_tokens": {"type": "integer", "minimum": 0},
        "cache_write_input_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "Problem": {
      "description": "Detalle de error RFC 9457 (application/problem+json).",
      "type": "object",
      "required": ["type", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "format": "uri-reference"},
        "title": {"type": "string"},
        "status": {"type": "integer", "minimum": 400, "maximum": 599},
        "detail": {"type": "string"},
        "instance": {"type": "string", "format": "uri-reference"},
        "trace_id": {"$ref": "#/$defs/TraceId"},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "additionalProperties": false,
            "properties": {"path": {"type": "string"}, "message": {"type": "string"}}
          }
        }
      }
    },
    "PageInfo": {
      "type": "object",
      "required": ["limit", "next_cursor"],
      "additionalProperties": false,
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "next_cursor": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "User": {
      "description": "Cuenta del panel. El segundo factor es obligatorio para operator y admin.",
      "type": "object",
      "required": ["id", "display_name", "roles", "mfa_enabled"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "display_name": {"type": "string", "maxLength": 80},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/Role"}, "minItems": 1, "uniqueItems": true},
        "mfa_enabled": {"type": "boolean"},
        "last_login_at": {"$ref": "#/$defs/Timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"roles": {"contains": {"enum": ["operator", "admin"]}}}},
          "then": {"properties": {"mfa_enabled": {"const": true}}}
        }
      ]
    },
    "StreamEvent": {
      "description": "Evento del flujo SSE del panel (/api/v1/events/stream).",
      "type": "object",
      "required": ["id", "type", "at", "data"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "Cursor monótono para Last-Event-ID."},
        "type": {"enum": ["run.finished", "job.state_changed", "alert.fired", "alert.resolved", "intervention.updated", "config.applied", "feedback.created", "heartbeat"]},
        "at": {"$ref": "#/$defs/Timestamp"},
        "data": {"type": "object"}
      }
    }
  }
}
