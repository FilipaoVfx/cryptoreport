# Copiar a .env (chmod 600). Nunca versionar .env.

# Obligatoria: clave de Scraper.Tech con suscripción (plan Free basta) a la "YouTube API" general,
# https://scraper.tech/panel/pricing/youtube/ — el endpoint usado es captions.php.
SCRAPER_TECH_KEY=

# Avisos por Telegram (opcionales). Sin ellos los avisos quedan en el journal de systemd.
CR_TELEGRAM_BOT_TOKEN=
CR_TELEGRAM_CHAT_ID=
# Avisar también de cada transcripción nueva (no solo de problemas)
CR_NOTIFY_SUCCESS=true

# Respaldo de pago: Supadata (https://supadata.ai). Plan Free: 100 créditos/mes.
SUPADATA_API_KEY=
# Generar con IA desde el audio cuando un video sigue sin subtítulos (2 créditos/min). Nunca en videos con doblaje.
CR_SUPADATA_GENERATE=true
CR_SUPADATA_GENERATE_AFTER_HOURS=6
# Tope de créditos que el servicio puede gastar al mes (nativo + generación)
CR_SUPADATA_MONTHLY_CREDITS=100

# Orden de proveedores: el primero que entregue texto gana. Los de pago (supadata) solo se consultan si
# los gratuitos fallan, nunca cuando ya se sabe que el video aún no tiene subtítulos.
CR_PROVIDERS=scrapertech,ytdlp,supadata
CR_LANGUAGE=es
CR_INCLUDE_SHORTS=true
# Solo se encolan videos publicados en esta ventana (el RSS trae los últimos 15 de cada canal)
CR_LOOKBACK_HOURS=72
# Pasado este tiempo sin subtítulos, el video queda como no_captions y se avisa
CR_GIVE_UP_HOURS=72
CR_MAX_ATTEMPTS=8
CR_MAX_VIDEOS_PER_RUN=20
# Cuota mensual contratada en Scraper.Tech; avisa al llegar al 80 %
CR_SCRAPERTECH_MONTHLY_QUOTA=1000

# Respaldo yt-dlp: proxy residencial (http://user:pass@host:port) o cookies.txt exportadas de un navegador
CR_YTDLP_PROXY=
CR_YTDLP_COOKIES=

# Por defecto: $STATE_DIRECTORY de systemd o /var/lib/cryptoreport-transcripts
# CR_DATA_DIR=
