# Copiar a .env (chmod 600). Nunca versionar .env.
# Clave de la API de Claude (console.anthropic.com). El SDK la lee del entorno.
ANTHROPIC_API_KEY=

# Modelo y profundidad. Opus 5.5 es el recomendado; Sonnet 5.5 cuesta la mitad y conviene compararlo con los casos de evaluación.
CRA_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Opus 5.5 usa medium por defecto; para análisis conviene high)
CRA_EFFORT=high
# Límite de salida, incluido el razonamiento. Un análisis truncado nunca se guarda como válido.
CRA_MAX_TOKENS=64000
# Reintento automático en otro modelo si el clasificador de seguridad rechaza la petición
CRA_FALLBACKS=true
CRA_INCLUDE_SHORTS=true
# Por defecto: /var/lib/cryptoreport-transcripts/{transcripts,analysis}
# CRA_DATA_DIR=
