# Copiar a .env (chmod 600). Nunca versionar .env.
# Bloqueo de gasto por API; Scheduled no necesita habilitarlo.
CRA_ALLOW_API_ANALYSIS=false
# Proveedor: openai (por defecto, gpt-6.1-sol) o anthropic (claude-opus-5-5). Cada SDK lee su clave del entorno.
CRA_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo (vacío = el predeterminado del proveedor) y profundidad de razonamiento.
CRA_MODEL=
# low | medium | high | xhigh | max (gpt-6.1-sol y Opus 5.5 usan medium por defecto; para análisis conviene high)
CRA_EFFORT=high
# Límite de salida, incluido el razonamiento. Un análisis truncado nunca se guarda como válido.
CRA_MAX_TOKENS=64000
# Solo Claude: reintento automático en otro modelo si el clasificador de seguridad rechaza la petición
CRA_FALLBACKS=true
CRA_INCLUDE_SHORTS=true
# Por defecto: /var/lib/cryptoreport-transcripts/{transcripts,analysis}
# CRA_DATA_DIR=
