# Se puede usar /etc/cryptoreport-bridge.env como EnvironmentFile de systemd.
CR_DRIVE_TRANSPORT=auto
CR_DRIVE_CLIENT_FILE=/etc/cryptoreport-drive/client.json
CR_DRIVE_TOKEN_FILE=/etc/cryptoreport-drive/token.json
# Estado de metadatos/recuperación; nunca contiene tokens.
CR_DRIVE_STATE_FILE=/var/lib/cryptoreport-transcripts/bridge/transport.sqlite
CRA_ALLOW_API_ANALYSIS=false
