[Unit]
Description=CryptoReport Urania: public Cloudflare quick tunnel
After=network-online.target cryptoreport-urania-web.service
Wants=network-online.target cryptoreport-urania-web.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8741 --no-autoupdate --protocol http2
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=192M

[Install]
WantedBy=multi-user.target
